        ".td-spinner__track",
        ".td-spinner__arc"
      ],
      "excludeProps": [
        "transform",
        "stroke-dashoffset",
        "stroke-dasharray"
      ]
    }
  ],
  "td-datetime-picker": [
    {
      "state": "open",
      "setup": "const p=document.createElement('td-datetime-picker'); p.id='probe'; p.setAttribute('value','15/06/2026 - 09:30'); window.__mount.appendChild(p); p._open();",
      "selectors": [
        ".td-dtp-wheel-container",
        ".td-dtp-wheel-option.selected"
      ],
      "portal": [
        ".td-dtp-wheel-container",
        ".td-dtp-wheel-option.selected"
      ],
      "settle": 400,
      "constructNote": "td-datetime-picker's ONLY blocking construct is the injected <style id=td-datetime-picker-styles> (gradient .td-dtp-wheel-container background-image, .selected font/color/transform, ::before band). Opens inside a TdModal portaled to body via _open(). This captures the directly-styled rules; the ::before pseudo-band parity is a Task-1 adopted-sheet concern (getComputedStyle can't key it by class alone here)."
    }
  ]
}
