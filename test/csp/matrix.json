  "td-table": [
    {
      "state": "data",
      "setup": "const t=document.createElement('td-table'); t.id='probe'; window.__mount.appendChild(t); t.columns=[{key:'name',label:'Name',width:'200px'},{key:'age',label:'Age'}]; t.data=[{name:'Ann',age:30},{name:'Bob',age:25},{name:'Cy',age:40}];",
      "selectors": [
        ".td-table-container",
        ".td-table-row[data-row-idx=\"0\"]",
        ".td-table-row[data-row-idx=\"1\"]",
        ".td-table-row[data-row-idx=\"0\"] td:first-child"
      ]
    },
    {
      "state": "data-no-zebra",
      "setup": "const t=document.createElement('td-table'); t.id='probe'; window.__mount.appendChild(t); t.columns=[{key:'name',label:'Name'}]; t.data=[{name:'Ann'},{name:'Bob'}];",
      "selectors": [
        ".td-table-container",
        ".td-table-row[data-row-idx=\"1\"]"
      ],
      "zebraNote": "_isZebra() is structurally always-true in v0.2.0 (!hasAttr||hasAttr); zebra row 1 is always tinted regardless of the zebra attribute"
    },
    {
      "state": "sortable-header",
      "setup": "const t=document.createElement('td-table'); t.id='probe'; window.__mount.appendChild(t); t.columns=[{key:'name',label:'Name',sortable:true},{key:'age',label:'Age'}]; t.data=[{name:'Ann',age:30}];",
      "selectors": [
        ".td-table-container",
        "thead th[data-sort-key=\"name\"]"
      ]
    },
    {
      "state": "loading",
      "setup": "const t=document.createElement('td-table'); t.id='probe'; t.setAttribute('loading',''); t.setAttribute('loading-rows','3'); window.__mount.appendChild(t); t.columns=[{key:'name',label:'Name',width:'200px'},{key:'age',label:'Age'}];",
      "selectors": [
        "#probe > div",
        "thead tr",
        "tbody tr:first-child",
        "tbody tr:nth-child(2)",
        "tbody tr:first-child td:first-child"
      ],
      "excludeProps": [
        "width"
      ],
      "selectorNote": "the loading skeleton root has no td-table-container class (only the data render does) — key it via #probe > div",
      "excludeNote": "loading skeleton bar widths use Math.random() — width excluded (non-deterministic). Row/cell border + zebra bg are deterministic."
    },
    {
      "state": "empty",
      "setup": "const t=document.createElement('td-table'); t.id='probe'; window.__mount.appendChild(t); t.columns=[{key:'name',label:'Name'}]; t.data=[];",
      "selectors": [
        ".td-table-container"
      ]
    }
  ],
