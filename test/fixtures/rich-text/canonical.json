[
  {"name":"plain text wrapped in p","input":"Hello","expected":"<p>Hello</p>","serverExpected":"Hello","note":"Symfony does not wrap stray inline content in <p>"},
  {"name":"empty document","input":"","expected":""},
  {"name":"two paragraphs","input":"<p>a</p><p>b</p>","expected":"<p>a</p><p>b</p>"},
  {"name":"hard break","input":"<p>a<br>b</p>","expected":"<p>a<br>b</p>"},
  {"name":"b becomes strong","input":"<p><b>x</b></p>","serverExpected":"<p>x</p>","note":"Symfony does not rewrite b → strong; b is not allowed so only its text is kept","expected":"<p><strong>x</strong></p>"},
  {"name":"i becomes em","input":"<p><i>x</i></p>","serverExpected":"<p>x</p>","note":"Symfony does not rewrite i → em","expected":"<p><em>x</em></p>"},
  {"name":"strike and del become s","input":"<p><strike>a</strike><del>b</del></p>","serverExpected":"<p>ab</p>","note":"Symfony does not rewrite strike / del → s","expected":"<p><s>ab</s></p>"},
  {"name":"em u s kept","input":"<p><em>a</em><u>b</u><s>c</s></p>","expected":"<p><em>a</em><u>b</u><s>c</s></p>"},
  {"name":"mark nesting order a, strong, em, u, s","input":"<p><s><u><em><strong><a href=\"https://e.com/\">t</a></strong></em></u></s></p>","serverExpected":"<p><s><u><em><strong><a href=\"https://e.com/\" rel=\"nofollow noopener\">t</a></strong></em></u></s></p>","note":"Symfony keeps the input nesting order; the client reorders marks","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\"><strong><em><u><s>t</s></u></em></strong></a></p>"},
  {"name":"inline content mixed with marks","input":"a <strong>b</strong> c","expected":"<p>a <strong>b</strong> c</p>","serverExpected":"a <strong>b</strong> c","note":"Symfony does not wrap stray inline content in <p>"},
  {"name":"whitespace runs collapse","input":"<p>a   \n  b\t\tc</p>","expected":"<p>a b c</p>"},
  {"name":"text escaping","input":"<p>a &amp; b &lt;c&gt; d&nbsp;e</p>","expected":"<p>a &amp; b &lt;c&gt; d&nbsp;e</p>"},
  {"name":"link without rel or target gets rel","input":"<p><a href=\"https://e.com/\">x</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\">x</a></p>"},
  {"name":"link target _blank kept (per link)","input":"<p><a href=\"https://e.com/\" target=\"_blank\">x</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\" target=\"_blank\">x</a></p>"},
  {"name":"link target _self dropped","input":"<p><a href=\"https://e.com/\" target=\"_self\">x</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\">x</a></p>"},
  {"name":"attribute order href, rel, target","input":"<p><a target=\"_blank\" rel=\"x noreferrer\" href=\"https://e.com/\">x</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener noreferrer\" target=\"_blank\">x</a></p>"},
  {"name":"partial marks","input":"<p><strong>a<em>b</em></strong>c</p>","expected":"<p><strong>a<em>b</em></strong>c</p>"},
  {"name":"nested marks inside link","input":"<p><a href=\"https://e.com/\"><strong>b</strong> t</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\"><strong>b</strong> t</a></p>"},
  {"name":"unknown span keeps text","input":"<p><span class=\"x\">a</span></p>","expected":"<p>a</p>"},
  {"name":"link rel noreferrer kept (per link)","input":"<p><a href=\"https://e.com/\" rel=\"noreferrer\">x</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener noreferrer\">x</a></p>"},
  {"name":"stored v0.88 HTML with target _blank round-trips unchanged","input":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\" target=\"_blank\">x</a> and <a href=\"https://e.com/\" rel=\"nofollow noopener\">y</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\" target=\"_blank\">x</a> and <a href=\"https://e.com/\" rel=\"nofollow noopener\">y</a></p>"},
  {"name":"own output with noreferrer and _blank round-trips","input":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener noreferrer\" target=\"_blank\">x</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener noreferrer\" target=\"_blank\">x</a></p>"},
  {"name":"link nested with bold / italic keeps its target and noreferrer","input":"<p><a href=\"https://e.com/\" target=\"_blank\" rel=\"noreferrer\"><strong>b</strong> <em>i</em> t</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"><strong>b</strong> <em>i</em> t</a></p>"},
  {"name":"two links, same href, different target stay two links","input":"<p><a href=\"https://e.com/\" target=\"_blank\">a</a><a href=\"https://e.com/\">b</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener\" target=\"_blank\">a</a><a href=\"https://e.com/\" rel=\"nofollow noopener\">b</a></p>"},
  {"name":"pasted HTML: target and rel kept per link, other attributes dropped","input":"<p><span style=\"color:red\"><a class=\"c\" data-x=\"1\" style=\"color:blue\" href=\"https://e.com/\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"t\">x</a></span> <a href=\"https://e.com/\" target=\"_top\" rel=\"external\">y</a></p>","expected":"<p><a href=\"https://e.com/\" rel=\"nofollow noopener noreferrer\" target=\"_blank\">x</a> <a href=\"https://e.com/\" rel=\"nofollow noopener\">y</a></p>"}
]
