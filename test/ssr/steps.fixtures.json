{
  "_note": "v0.45.0 (plan v0.45.0-steps-timeline QĐ S1–S6, G3, M4) SSR contract steps@1 (ADR 0012): td_steps() ALWAYS prints <td-steps data-td-ssr=\"steps@1\"> + the exact tree <td-steps> builds, hydrated IN PLACE. Shared by test/php/td-ssr-steps-timeline.test.js and src/display/td-steps.ssr.engines.browser-test.js (via test/ssr/fixtures/steps.html — GENERATED by `node test/ssr/build-steps-timeline-fixture.mjs`; the PHP test fails when it is stale). expect.states / anchor (index, -1 none) / summary / tags = the step element of each li AFTER the hydrate (a | span | button); warnings = the codes of the one E_USER_WARNING td_steps raises (swallowed by the fixture script).",
  "schema": "steps@1",
  "cases": [
    {
      "id": "s-basic",
      "args": [[{ "label": "Tải tệp" }, { "label": "Kiểm tra dữ liệu", "description": "Đã đọc 1.250 dòng" }, { "label": "Xem trước" }, { "label": "Nhập" }, { "label": "Xong" }], { "current": "2" }],
      "expect": { "states": ["done", "current", "upcoming", "upcoming", "upcoming"], "anchor": 1, "summary": "Bước 2/5: Kiểm tra dữ liệu", "tags": ["span", "span", "span", "span", "span"], "warnings": [] }
    },
    {
      "id": "s-error",
      "args": [[{ "label": "Tải tệp" }, { "label": "Kiểm tra dữ liệu", "state": "error", "description": "Dòng 12: thiếu IMEI" }, { "label": "Nhập" }], { "current": "2", "navigation": "back" }],
      "expect": { "states": ["done", "error", "upcoming"], "anchor": 1, "summary": "Bước 2/3: Kiểm tra dữ liệu", "tags": ["button", "span", "span"], "warnings": [] }
    },
    {
      "id": "s-complete",
      "args": [[{ "label": "A" }, { "label": "B" }, { "label": "C" }], { "complete": true, "navigation": "back", "label": "Nhập kho" }],
      "expect": { "states": ["done", "done", "done"], "anchor": -1, "summary": "Đã hoàn tất 3/3 bước", "tags": ["button", "button", "button"], "warnings": [] }
    },
    {
      "id": "s-none",
      "args": [[{ "label": "A" }, { "label": "B" }, { "label": "C" }, { "label": "D" }], {}],
      "expect": { "states": ["upcoming", "upcoming", "upcoming", "upcoming"], "anchor": -1, "summary": "4 bước", "tags": ["span", "span", "span", "span"], "warnings": [] }
    },
    {
      "id": "s-links",
      "args": [[{ "label": "Thông tin", "href": "?step=1" }, { "label": "Địa chỉ" }, { "label": "Thanh toán", "href": "javascript:alert(1)" }, { "label": "Xác nhận", "href": "?step=4" }], { "current": "4", "navigation": "all" }],
      "expect": { "states": ["done", "done", "done", "current"], "anchor": 3, "summary": "Bước 4/4: Xác nhận", "tags": ["a", "button", "button", "span"], "warnings": [] }
    },
    {
      "id": "s-vertical",
      "args": [[{ "key": "upload", "label": "Tải lên", "description": "tệp .xlsx" }, { "key": "check", "label": "Kiểm tra", "disabled": true }, { "key": "done", "label": "Xong" }], { "current": "check", "orientation": "vertical", "narrow": "vertical", "id": "st-v", "class": "my-steps", "attrs": { "data-scope": "import", "onclick": "alert(1)", "style": "color:red", "data-td-x": "1" } }],
      "expect": { "states": ["done", "current", "upcoming"], "anchor": 1, "summary": "Bước 2/3: Kiểm tra", "tags": ["span", "span", "span"], "warnings": [] },
      "dropOnHost": ["onclick", "style", "data-td-x"]
    },
    {
      "id": "s-conflict",
      "args": [[{ "label": "A" }, { "label": "B" }, { "label": "C", "state": "current" }, { "label": "D", "state": "upcoming" }], { "current": "2", "navigation": "back" }],
      "expect": { "states": ["done", "current", "upcoming", "upcoming"], "anchor": 1, "summary": "Bước 2/4: B", "tags": ["button", "span", "span", "span"], "warnings": ["extra-current"] }
    },
    {
      "id": "s-explicit",
      "args": [[{ "label": "A", "state": "upcoming" }, { "label": "B", "state": "error" }, { "label": "C", "state": "current" }, { "label": "D", "state": "done" }], { "current": "nope" }],
      "expect": { "states": ["upcoming", "error", "current", "done"], "anchor": 2, "summary": "Bước 3/4: C", "tags": ["span", "span", "span", "span"], "warnings": ["current-unmatched"] }
    },
    {
      "id": "s-special",
      "args": [[{ "key": "a\"b<c>", "label": "<img src=x onerror=alert(1)> & 'q'", "description": "\"><svg onload=alert(1)>" }, { "key": 7, "label": 12.5 }], { "current": "7" }],
      "expect": { "states": ["done", "current"], "anchor": 1, "summary": "Bước 2/2: 12.5", "tags": ["span", "span"], "warnings": [] }
    },
    {
      "id": "s-empty",
      "args": [[], { "current": "1" }],
      "expect": { "states": [], "anchor": -1, "summary": null, "tags": [], "warnings": [], "hidden": true }
    }
  ]
}
