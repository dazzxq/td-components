{
  "_note": "v0.29.0 (plan v0.29.0-tree M8) td_tree_select(): a NATIVE <select> that works without JS (preorder options, NBSP indent + data-level + data-label, locks: data-locked; single locked selection = the only enabled option; multiple locked selection = disabled selected + one hidden input.td-tree-select__locked each; cascade parents disabled data-native-only), inside <td-tree-select> (native mode: no marker, size rows for multiple) or, in ELEMENT mode (`element => true` or Td::configure ssr_elements), <td-tree-select data-td-ssr=\"tree-select@1\"> + select.td-tree-select__native styled to the trigger box (single AND multiple: no layout shift on upgrade). Shared by test/php/td-ssr-tree-select.test.js (PHP output) and src/form/td-tree-select.ssr.engines.browser-test.js (Chromium / Firefox / WebKit, via test/ssr/fixtures/tree-select.html — GENERATED by `node test/ssr/build-tree-select-fixture.mjs`; the PHP test fails when it is stale). An argument \"@cats\" / \"@perms\" is replaced by `trees.cats` / `trees.perms`. `cases`: element mode per call unless `global`; the options array is the LAST argument. `expect`: state after the upgrade. `submit`: FormData of the form without JS AND after the upgrade (same; `submitAfter` only where the native empty option submits \"\" and the component submits nothing). `valid`: form.checkValidity() before AND after.",
  "schema": "tree-select@1",
  "trees": {
    "cats": [
      { "value": "phone", "label": "Điện thoại", "children": [
        { "value": "apple", "label": "Apple", "children": [{ "value": "ip15", "label": "iPhone 15" }, { "value": "ip16", "label": "iPhone 16" }] },
        { "value": "samsung", "label": "Samsung", "children": [{ "value": "s24", "label": "Galaxy S24" }] }
      ] },
      { "value": "laptop", "label": "Laptop", "description": "Máy tính xách tay", "children": [{ "value": "dell", "label": "Dell" }] },
      { "value": "acc", "label": "Phụ kiện" }
    ],
    "perms": [
      { "value": "post", "label": "Bài viết", "children": [
        { "value": "post.read", "label": "Xem" }, { "value": "post.write", "label": "Sửa" }, { "value": "post.del", "label": "Xoá", "disabled": true }
      ] },
      { "value": "user", "label": "Người dùng", "children": [{ "value": "user.read", "label": "Xem người dùng" }] }
    ]
  },
  "cases": [
    { "id": "s-basic", "args": ["parent", "@cats", "ip15", { "id": "s-basic", "label": "Danh mục cha", "placeholder": "— Không có —" }],
      "expect": { "value": "ip15", "text": "iPhone 15", "placeholder": "— Không có —", "allowClear": true }, "submit": [["parent", "ip15"]], "valid": true, "box": true },
    { "id": "s-path", "args": ["cat", "@cats", "s24", { "id": "s-path", "label": "Chuyên mục", "display": "path" }],
      "expect": { "value": "s24", "text": "Điện thoại › Samsung › Galaxy S24" }, "submit": [["cat", "s24"]], "valid": true, "box": true },
    { "id": "s-subtree", "args": ["parent", "@cats", "phone", { "id": "s-subtree", "label": "Danh mục cha", "placeholder": "— Gốc —", "disable_subtree": ["apple"] }],
      "expect": { "value": "phone", "locked": ["apple", "ip15", "ip16"] }, "submit": [["parent", "phone"]], "valid": true },
    { "id": "s-locked", "args": ["owner", "@cats", "apple", { "id": "s-locked", "label": "Khoá", "placeholder": "— Không —", "disable_subtree": ["apple"] }],
      "expect": { "value": "apple", "singleLocked": true, "allowClear": false }, "submit": [["owner", "apple"]], "valid": true },
    { "id": "s-required", "args": ["req", "@cats", null, { "id": "s-required", "label": "Bắt buộc", "placeholder": "— Chọn —", "required": true }],
      "expect": { "value": "", "required": true }, "submit": [["req", ""]], "submitAfter": [], "valid": false, "box": true },
    { "id": "m-basic", "args": ["cats[]", "@cats", ["acc", "dell"], { "id": "m-basic", "multiple": true, "label": "Chuyên mục", "placeholder": "Chọn chuyên mục" }],
      "expect": { "value": ["dell", "acc"], "text": "Dell, Phụ kiện" }, "submit": [["cats[]", "dell"], ["cats[]", "acc"]], "valid": true, "box": true },
    { "id": "m-locked", "args": ["perm[]", "@perms", ["post.read", "post.del"], { "id": "m-locked", "multiple": true, "cascade": true, "required": true, "label": "Quyền" }],
      "expect": { "value": ["post.read", "post.del"], "required": true, "cascade": true, "locked": ["post.del"] }, "submit": [["perm[]", "post.read"], ["perm[]", "post.del"]], "valid": true, "box": true },
    { "id": "m-locked-only", "args": ["perm2[]", "@perms", ["post.del"], { "id": "m-locked-only", "multiple": true, "required": true, "label": "Chỉ mục khoá" }],
      "expect": { "value": ["post.del"], "required": true }, "submit": [["perm2[]", "post.del"]], "valid": true },
    { "id": "m-disabled", "args": ["perm3[]", "@perms", ["post.del", "user.read"], { "id": "m-disabled", "multiple": true, "disabled": true, "label": "Tắt" }],
      "expect": { "value": ["post.del", "user.read"], "disabled": true }, "submit": [], "valid": true },
    { "id": "m-global", "global": true, "args": ["g[]", "@cats", ["acc"], { "id": "m-global", "multiple": true, "aria_label": "Toàn cục" }],
      "expect": { "value": ["acc"] }, "submit": [["g[]", "acc"]], "valid": true },
    { "id": "s-xss", "args": ["x\"y", [{ "value": "<b>v</b>", "label": "<img src=x onerror=alert(1)>", "description": "\"><script>d</script>" }, { "value": "q\"", "label": "\"q\"" }], "q\"", { "id": "s-xss", "label": "<i>nhãn</i>" }],
      "expect": { "value": "q\"", "text": "\"q\"" }, "submit": [["x\"y", "q\""]], "valid": true }
  ],
  "nativeCases": [
    { "id": "n-single", "args": ["n", "@cats", "dell", { "id": "n-single", "label": "Native" }], "submit": [["n", "dell"]] },
    { "id": "n-multi", "args": ["nm[]", "@cats", ["acc", "ip16"], { "id": "n-multi", "multiple": true, "label": "Native nhiều" }], "submit": [["nm[]", "ip16"], ["nm[]", "acc"]] }
  ],
  "modes": [
    { "global": false, "call": "absent", "element": false },
    { "global": false, "call": false, "element": false },
    { "global": false, "call": true, "element": true },
    { "global": true, "call": "absent", "element": true },
    { "global": true, "call": false, "element": false },
    { "global": true, "call": true, "element": true }
  ]
}
