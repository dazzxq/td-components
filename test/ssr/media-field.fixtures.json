{
  "_note": "v0.32.0 (plan v0.32.0-media-picker decisions 24-25, 29, M5) SSR contract media-field@1 (ADR 0012): td_media_field() ALWAYS prints the element `<td-media-field data-td-ssr=\"media-field@1\">` + the exact tree <td-media-field> renders + the no-JS form parts (hidden `input.td-media-field__value` / `__crop`, the alt input name), adopted IN PLACE. Shared by test/php/td-ssr-media-field.test.js and src/form/td-media-field.ssr.engines.browser-test.js (Chromium / Firefox / WebKit, via test/ssr/fixtures/media-field.html — GENERATED by `node test/ssr/build-media-field-fixture.mjs`; the PHP test fails when it is stale). `args` = td_media_field(name, assetId, options). `expect.entries`: the FormData of the case (before AND after define). `warns`: the case triggers E_USER_WARNING (silenced by the fixture script, counted by the PHP test). `dropOnHost`: `attrs` entries that must not reach the host. The `free` case comes first (its box depends on the image load).",
  "schema": "media-field@1",
  "cases": [
    { "id": "free", "args": ["free", "m4", { "label": "Không tỉ lệ", "preview_src": "/test/fixtures/4.svg", "preview_alt": "Ảnh 4" }],
      "expect": { "value": "m4", "entries": [["free", "m4"]] } },
    { "id": "ref-empty", "args": ["hero", null, { "label": "Ảnh đại diện", "aspect_ratio": "3/2" }],
      "expect": { "value": "", "entries": [["hero", ""]], "ratio": "3:2" } },
    { "id": "ref-filled", "args": ["cover", "m1", { "label": "Ảnh bìa", "aspect_ratio": "3/2", "preview_src": "/test/fixtures/1.svg", "preview_alt": "Ảnh 1", "helper_text": "JPG, PNG, tối đa 5 MB" }],
      "expect": { "value": "m1", "entries": [["cover", "m1"]] } },
    { "id": "usage-full", "args": ["og", "m2", { "label": "Ảnh OG", "usage": true, "aspect_ratio": "1.91", "alt": "Mô tả có sẵn", "crop": { "x": 0.1, "y": 0, "width": 0.5, "height": 1 }, "preview_src": "/test/fixtures/2.svg", "preview_alt": "og.jpg" }],
      "expect": { "value": "m2", "entries": [["og[id]", "m2"], ["og[alt]", "Mô tả có sẵn"], ["og[crop]", "{\"v\":1,\"x\":0.1,\"y\":0,\"width\":0.5,\"height\":1}"]], "ratio": "1.91:1" } },
    { "id": "usage-empty", "args": ["og2", null, { "label": "OG trống", "usage": true }],
      "expect": { "value": "", "entries": [["og2[id]", ""], ["og2[alt]", ""], ["og2[crop]", "null"]] } },
    { "id": "contain", "args": ["logo", "m3", { "label": "Logo", "aspect_ratio": "1:1", "preview_fit": "contain", "preview_src": "/test/fixtures/3.svg" }],
      "expect": { "value": "m3", "entries": [["logo", "m3"]] } },
    { "id": "video", "args": ["clip", "m14", { "label": "Video", "kind": "video", "accept_kind": ["video"], "aspect_ratio": "16/9", "preview_src": "/test/fixtures/2.svg", "preview_alt": "clip.mp4" }],
      "expect": { "value": "m14", "entries": [["clip", "m14"]] } },
    { "id": "file", "args": ["doc", "m11", { "label": "Tài liệu", "kind": "file", "accept_kind": "file", "preview_alt": "tai-lieu.pdf" }],
      "expect": { "value": "m11", "entries": [["doc", "m11"]] } },
    { "id": "disabled", "args": ["dis", "m1", { "label": "Khoá", "disabled": true, "usage": true, "alt": "x", "preview_src": "/test/fixtures/1.svg" }],
      "expect": { "value": "m1", "entries": [], "disabled": true } },
    { "id": "required-error", "args": ["req", null, { "label": "Bắt buộc", "required": true, "error_text": "Vui lòng chọn ảnh." }],
      "expect": { "value": "", "entries": [["req", ""]], "required": true, "error": "Vui lòng chọn ảnh." } },
    { "id": "unsafe-src", "args": ["u", "m1", { "label": "URL độc", "preview_src": "javascript:alert(1)", "preview_alt": "x.jpg" }],
      "expect": { "value": "m1", "entries": [["u", "m1"]], "noImg": true } },
    { "id": "array-usage", "args": ["list[]", "m1", { "label": "Sai tên", "usage": true }], "warns": 1,
      "expect": { "value": "m1", "entries": [] } },
    { "id": "attrs", "args": ["att", null, { "id": "mf-att", "class": "a b", "attrs": { "data-x": "1", "onclick": "alert(1)", "style": "color:red", "value": "evil", "Label": "evil", "data-td-z": "1", "title": "Gợi ý" } }],
      "expect": { "value": "", "entries": [["att", ""]], "hostId": "mf-att" }, "dropOnHost": ["onclick", "style", "data-td-z"] },
    { "id": "xss", "args": ["x\"y", "id\"<1>", { "label": "<img src=x onerror=alert(1)>", "prompt": "<b>p</b>", "helper_text": "<i>h</i>", "preview_alt": "<script>alert(1)</script>" }],
      "expect": { "value": "id\"<1>", "entries": [["x\"y", "id\"<1>"]] } }
  ]
}
