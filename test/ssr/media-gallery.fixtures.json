{
  "_note": "v0.43.0 (plan v0.43.0-media-gallery decisions 8, 14-15b, 19-20, M2 / M6) SSR contract media-gallery@1 (ADR 0012, ADR 0021): td_media_gallery() ALWAYS prints the element `<td-media-gallery data-td-ssr=\"media-gallery@1\">` + the exact tree <td-media-gallery> renders + the no-JS form parts (hidden `input.td-media-gallery__value` / `__crop` / `__focal`, the alt input `name` / `value`), adopted IN PLACE. Shared by test/php/td-ssr-media-gallery.test.js and src/form/td-media-gallery.ssr.engines.browser-test.js (Chromium / Firefox / WebKit, via test/ssr/fixtures/media-gallery.html — GENERATED by `node test/ssr/build-media-gallery-fixture.mjs`; the PHP test fails when it is stale). `args` = td_media_gallery(name, items, options). `expect.entries`: the FormData of the case (no JS, AND after define). `expect.value`: the ids. `expect.state`: ok | overflow | broken. `warns`: the case triggers E_USER_WARNING (silenced by the fixture script, counted by the PHP test).",
  "schema": "media-gallery@1",
  "cases": [
    { "id": "empty", "args": ["gallery", [], { "label": "Ảnh sản phẩm" }],
      "expect": { "value": [], "state": "ok", "entries": [["gallery", ""]] } },
    { "id": "ref", "args": ["images", [
        { "id": "m1", "src": "/test/fixtures/1.svg", "name": "Ảnh 1" },
        { "id": "m2", "src": "/test/fixtures/2.svg", "name": "Ảnh 2" },
        { "id": "m3", "src": "/test/fixtures/3.svg" }
      ], { "label": "Ảnh bài viết", "max": 6, "aspect_ratio": "4/3", "helper_text": "Kéo để sắp xếp" }],
      "expect": { "value": ["m1", "m2", "m3"], "state": "ok", "entries": [["images[]", "m1"], ["images[]", "m2"], ["images[]", "m3"]] } },
    { "id": "usage", "args": ["g", [
        { "id": "m1", "src": "/test/fixtures/1.svg", "name": "Ảnh 1", "alt": "Áo thun trắng", "crop": { "x": 0.1, "y": 0, "width": 0.5, "height": 1 }, "focal": { "x": 0.25, "y": 0.5 } },
        { "id": "m2", "src": "/test/fixtures/2.svg", "name": "Ảnh 2", "alt": "", "crop": "{\"v\":1,\"x\":0,\"y\":0,\"width\":1,\"height\":0.5}" }
      ], { "label": "Gallery", "usage": true, "croppable": true, "focal_point": true, "cover": true, "crop_ratio": "1:1", "aspect_ratio": "1/1", "max": 4, "min": 1 }],
      "expect": { "value": ["m1", "m2"], "state": "ok", "entries": [
        ["g[0][id]", "m1"], ["g[0][alt]", "Áo thun trắng"], ["g[0][crop]", "{\"v\":1,\"x\":0.1,\"y\":0,\"width\":0.5,\"height\":1}"], ["g[0][focal]", "{\"v\":1,\"x\":0.25,\"y\":0.5}"],
        ["g[1][id]", "m2"], ["g[1][alt]", ""], ["g[1][crop]", "{\"v\":1,\"x\":0,\"y\":0,\"width\":1,\"height\":0.5}"], ["g[1][focal]", "null"]] } },
    { "id": "usage-empty", "args": ["ue", [], { "label": "Trống", "usage": true }],
      "expect": { "value": [], "state": "ok", "entries": [["ue", ""]] } },
    { "id": "kinds", "args": ["m", [
        { "id": "m14", "kind": "video", "src": "/test/fixtures/2.svg", "name": "clip.mp4" },
        { "id": "m11", "kind": "file", "name": "tai-lieu.pdf" },
        { "id": "m9" }
      ], { "label": "Tệp", "accept_kind": "image video file" }],
      "expect": { "value": ["m14", "m11", "m9"], "state": "ok", "entries": [["m[]", "m14"], ["m[]", "m11"], ["m[]", "m9"]] } },
    { "id": "full", "args": ["f", [
        { "id": "m1", "src": "/test/fixtures/1.svg" }, { "id": "m2", "src": "/test/fixtures/2.svg" }, { "id": "m3", "src": "/test/fixtures/3.svg" }
      ], { "label": "Đủ", "max": 3 }],
      "expect": { "value": ["m1", "m2", "m3"], "state": "ok", "entries": [["f[]", "m1"], ["f[]", "m2"], ["f[]", "m3"]] } },
    { "id": "disabled", "args": ["d", [{ "id": "m1", "src": "/test/fixtures/1.svg", "alt": "x" }], { "label": "Khoá", "usage": true, "disabled": true }],
      "expect": { "value": ["m1"], "state": "ok", "entries": [] } },
    { "id": "overflow", "args": ["o", [
        { "id": "m1", "src": "/test/fixtures/1.svg" }, { "id": "m2", "src": "/test/fixtures/2.svg" }, { "id": "m3", "src": "/test/fixtures/3.svg" }, { "id": "m4", "src": "/test/fixtures/4.svg" }
      ], { "label": "Vượt", "usage": true, "max": 2 }], "warns": true,
      "expect": { "value": ["m1", "m2", "m3", "m4"], "state": "overflow", "entries": [] } },
    { "id": "broken-dup", "args": ["b", [{ "id": "m1" }, { "id": "m1" }], { "label": "Hỏng" }], "warns": true,
      "expect": { "value": [], "state": "broken", "entries": [] } },
    { "id": "broken-name", "args": ["x[]", [{ "id": "m1" }], { "label": "Tên sai" }], "warns": true,
      "expect": { "value": [], "state": "broken", "entries": [] } },
    { "id": "int-ids", "args": ["n", [{ "id": 0 }, { "id": 42 }], { "label": "Id số" }],
      "expect": { "value": ["0", "42"], "state": "ok", "entries": [["n[]", "0"], ["n[]", "42"]] } },
    { "id": "required-error", "args": ["r", [], { "label": "Bắt buộc", "required": true, "error_text": "Chọn ít nhất một ảnh", "helper_text": "Tối đa 10 ảnh", "max": 10 }],
      "expect": { "value": [], "state": "ok", "entries": [["r", ""]] } },
    { "id": "no-name", "args": ["", [{ "id": "m1", "src": "/test/fixtures/1.svg" }], { "label": "Không tên" }],
      "expect": { "value": ["m1"], "state": "ok", "entries": [] } },
    { "id": "attrs", "args": ["att", [], { "label": "Attrs", "id": "mg-att", "class": "a b", "attrs": { "data-x": "1", "title": "Gợi ý", "onclick": "alert(1)", "style": "color:red", "ITEMS": "[]", "data-td-z": "1", "max": "9" } }],
      "expect": { "value": [], "state": "ok", "entries": [["att", ""]] } },
    { "id": "xss", "args": ["x\"y", [{ "id": "id\"<1>", "src": "/test/fixtures/1.svg", "name": "<img src=x onerror=alert(1)>", "alt": "<script>alert(1)</script>" }], { "label": "<b>nhãn</b>", "usage": true, "prompt": "<i>p</i>" }],
      "expect": { "value": ["id\"<1>"], "state": "ok", "entries": [["x\"y[0][id]", "id\"<1>"], ["x\"y[0][alt]", "<script>alert(1)</script>"], ["x\"y[0][crop]", "null"]] } },
    { "id": "v051-line", "args": ["c", [
        { "id": "m1", "src": "/test/fixtures/1.svg", "name": "Ảnh 1", "alt": "Áo", "caption": "Dòng 1\nDòng 2" },
        { "id": "m2", "src": "/test/fixtures/2.svg", "name": "Ảnh 2" }
      ], { "label": "Caption một dòng", "usage": true, "caption": true }],
      "expect": { "value": ["m1", "m2"], "state": "ok", "entries": [
        ["c[0][id]", "m1"], ["c[0][alt]", "Áo"], ["c[0][caption]", "Dòng 1 Dòng 2"], ["c[0][crop]", "null"],
        ["c[1][id]", "m2"], ["c[1][alt]", ""], ["c[1][caption]", ""], ["c[1][crop]", "null"]] } },
    { "id": "v051-multiline", "args": ["m", [
        { "id": "m1", "src": "/test/fixtures/1.svg", "name": "Ảnh 1", "caption": "a\nb <b>x</b>" },
        { "id": "m2", "src": "/test/fixtures/2.svg", "name": "Ảnh 2", "caption": "\nđầu xuống dòng" }
      ], { "label": "Caption nhiều dòng", "usage": true, "caption": "multiline", "caption_maxlength": 15 }],
      "expect": { "value": ["m1", "m2"], "state": "ok", "entries": [
        ["m[0][id]", "m1"], ["m[0][alt]", ""], ["m[0][caption]", "a\nb <b>x</b>"], ["m[0][crop]", "null"],
        ["m[1][id]", "m2"], ["m[1][alt]", ""], ["m[1][caption]", "\nđầu xuống dòng"], ["m[1][crop]", "null"]] } },
    { "id": "v051-limits", "args": ["l", [
        { "id": "m1", "src": "/test/fixtures/1.svg", "name": "Ảnh 1", "alt": "12345678", "caption": "abcdef" },
        { "id": "m2", "src": "/test/fixtures/2.svg", "name": "Ảnh 2", "alt": "0123456789A", "caption": "abcde" }
      ], { "label": "Giới hạn", "usage": true, "caption": true, "alt_maxlength": 10, "caption_maxlength": 5 }],
      "expect": { "value": ["m1", "m2"], "state": "ok", "entries": [
        ["l[0][id]", "m1"], ["l[0][alt]", "12345678"], ["l[0][caption]", "abcdef"], ["l[0][crop]", "null"],
        ["l[1][id]", "m2"], ["l[1][alt]", "0123456789A"], ["l[1][caption]", "abcde"], ["l[1][crop]", "null"]] } },
    { "id": "v051-off", "args": ["o", [
        { "id": "m1", "src": "/test/fixtures/1.svg", "name": "Ảnh 1", "alt": "Áo", "caption": "Bị bỏ qua" }
      ], { "label": "Không caption", "usage": true }],
      "expect": { "value": ["m1"], "state": "ok", "entries": [["o[0][id]", "m1"], ["o[0][alt]", "Áo"], ["o[0][crop]", "null"]] } },
    { "id": "v051-ref-caption", "warns": true, "args": ["r", [{ "id": "m1", "src": "/test/fixtures/1.svg", "caption": "x" }],
        { "label": "Reference + caption", "caption": true }],
      "expect": { "value": ["m1"], "state": "ok", "entries": [["r[]", "m1"]] } }
  ]
}
