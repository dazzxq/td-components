{
  "_note": "v0.94.0 (plan v0.94.0-icons-picker §7, §9.3) SSR contract icon-picker@1 (ADR 0012): td_icon_picker() ALWAYS prints the element `<td-icon-picker data-td-ssr=\"icon-picker@1\">` + the exact tree <td-icon-picker> builds (label, box > trigger button [glyph + canonical name + chevron] + clear button, the sr-only name span when only aria_label is given) + a no-JS `input[type=hidden].td-icon-picker__native` carrying name / value (removed on upgrade, after ElementInternals took the value). Shared by test/php/td-ssr-icon-picker.test.js (PHP output) and src/form/td-icon-picker.ssr.engines.browser-test.js (Chromium / Firefox / WebKit, via test/ssr/fixtures/icon-picker.html — GENERATED by `node test/ssr/build-icon-picker-fixture.mjs`; the PHP test fails when it is stale). `expect`: the state the hydrated element must hold. `tamper`: cases the browser test edits before the upgrade (a refused markup → safe render).",
  "schema": "icon-picker@1",
  "cases": [
    { "id": "basic", "args": ["icon", { "label": "Icon mục" }], "expect": { "value": "", "state": "empty", "text": "Chọn icon", "clear": false } },
    { "id": "value", "args": ["icon", { "label": "Icon mục", "value": "trash" }], "expect": { "value": "trash", "state": "value", "text": "trash", "clear": true } },
    { "id": "alias", "args": ["icon", { "label": "Icon mục", "value": "x" }], "expect": { "value": "close", "state": "value", "text": "close", "clear": true } },
    { "id": "aria-only", "args": ["icon", { "aria_label": "Icon của nút", "value": "home" }], "expect": { "value": "home", "state": "value", "text": "home", "clear": true, "name": "Icon của nút" } },
    { "id": "suggestions", "args": ["icon", { "label": "Icon", "value": "user", "suggestions": ["home", "user", "settings", "x"], "icons": "home user settings close trash" }], "expect": { "value": "user", "state": "value", "clear": true, "suggestions": ["home", "user", "settings", "close"], "icons": ["home", "user", "settings", "close", "trash"] } },
    { "id": "unknown", "args": ["icon", { "label": "Icon", "value": "site-later" }], "expect": { "value": "site-later", "state": "unknown", "text": "site-later", "clear": true }, "warns": true },
    { "id": "required-error", "args": ["icon", { "label": "Icon", "required": true, "helper_text": "Hiện cạnh tên mục", "error": "Chọn một icon" }], "expect": { "value": "", "state": "empty", "clear": false, "required": true, "error": "Chọn một icon" } },
    { "id": "helper", "args": ["icon", { "label": "Icon", "value": "star", "helper_text": "Hiện cạnh tên mục", "placeholder": "Chưa có icon" }], "expect": { "value": "star", "state": "value", "clear": true } },
    { "id": "placeholder", "args": ["icon", { "label": "Icon", "placeholder": "Chưa có icon" }], "expect": { "value": "", "state": "empty", "text": "Chưa có icon", "clear": false } },
    { "id": "disabled", "args": ["icon", { "label": "Icon", "value": "home", "disabled": true }], "expect": { "value": "home", "state": "value", "clear": false, "disabled": true } },
    { "id": "readonly", "args": ["icon", { "label": "Icon", "value": "home", "readonly": true }], "expect": { "value": "home", "state": "value", "clear": false, "readonly": true } },
    { "id": "no-clear", "args": ["icon", { "label": "Icon", "value": "home", "allow_clear": false }], "expect": { "value": "home", "state": "value", "clear": false } },
    { "id": "id", "args": ["icon", { "label": "Icon", "id": "my-icon", "value": "search" }], "expect": { "value": "search", "state": "value", "clear": true } },
    { "id": "escape", "args": ["icon", { "label": "<b>Icon</b> & \"x\"", "placeholder": "<img src=x onerror=alert(1)>" }], "expect": { "value": "", "state": "empty", "text": "<img src=x onerror=alert(1)>", "label": "<b>Icon</b> & \"x\"" } },
    { "id": "no-name", "args": ["", { "label": "Icon", "value": "home" }], "expect": { "value": "home", "state": "value", "clear": true } }
  ]
}
