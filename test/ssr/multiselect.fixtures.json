{
  "_note": "v0.28.0 (plan v0.28.0-multiselect M3 + M5) td_multiselect(): NATIVE by default (`div.td-multiselect` + [label] + `select.td-multiselect__native` multiple — submits every selected value without JS); ELEMENT mode (`element => true` or Td::configure ssr_elements) prints `<td-chip-input data-td-ssr=\"chip-input@1\" selection-only …>` + [label] + `select.td-chip-input__native` multiple, upgraded by <td-chip-input> through the <select multiple> path (M3). Shared by test/php/td-ssr-multiselect.test.js (PHP output) and src/form/td-v028-multiselect.engines.browser-test.js (Chromium / Firefox / WebKit, via test/ssr/fixtures/multiselect.html — GENERATED by `node test/ssr/build-multiselect-fixture.mjs`; the PHP test fails when it is stale). `cases`: element mode per call unless `global` (Td::configure(..., ['ssr_elements' => true])); the options array is the LAST argument. `expect`: state after the upgrade (values in order, leaf count, group labels, disabled leaves, host attributes). `browser: focus` → the case is focused before the module loads (deferral until blur). `dropped`: `attrs` entries that must never be printed.",
  "schema": "chip-input@1",
  "cases": [
    { "id": "m-basic", "args": ["roles[]", { "admin": "Quản trị", "editor": "Biên tập", "viewer": "Xem" }, ["editor", "viewer"], { "label": "Vai trò", "id": "m-basic" }],
      "expect": { "values": ["editor", "viewer"], "leaves": 3, "name": "roles[]", "label": "Vai trò" } },
    { "id": "m-groups", "args": ["cities[]", [
        { "label": "Miền Bắc", "options": { "hn": "Hà Nội", "hp": "Hải Phòng" } },
        { "label": "Miền Nam", "disabled": true, "options": [{ "value": "hcm", "label": "TP Hồ Chí Minh" }, { "value": "ct", "label": "Cần Thơ" }] },
        { "value": "dn", "label": "Đà Nẵng", "disabled": true },
        { "value": "hue", "label": "Huế", "description": "Cố đô" }
      ], ["hp"], { "label": "Thành phố", "id": "m-groups", "select_all": true }],
      "expect": { "values": ["hp"], "leaves": 6, "groups": ["Miền Bắc", "Miền Nam"], "disabled": ["hcm", "ct", "dn"], "selectAll": true, "name": "cities[]" } },
    { "id": "m-required", "args": ["tags[]", { "a": "A", "b": "B", "c": "C" }, [], { "label": "Thẻ", "id": "m-required", "required": true, "max_items": 2, "placeholder": "Tìm thẻ…", "size": 3 }],
      "expect": { "values": [], "leaves": 3, "required": true, "maxItems": "2", "placeholder": "Tìm thẻ…", "name": "tags[]" } },
    { "id": "m-disabled", "args": ["d[]", { "x": "X", "y": "Y" }, ["y"], { "id": "m-disabled", "disabled": true, "aria_label": "Danh sách khoá" }],
      "expect": { "values": ["y"], "leaves": 2, "disabled": true, "ariaLabel": "Danh sách khoá", "name": "d[]" } },
    { "id": "m-global", "global": true, "args": ["g[]", { "1": "Một", "2": "Hai" }, [2], { "id": "m-global", "label": "Toàn cục", "close_on_select": true }],
      "expect": { "values": ["2"], "leaves": 2, "closeOnSelect": true, "name": "g[]" } },
    { "id": "m-attrs", "args": ["p[]", { "a": "A" }, [], { "id": "m-attrs", "class": "a b", "attrs": { "data-x": "1", "onclick": "alert(1)", "Name": "evil", "value": "[\"a\"]", "selection-only": "x", "data-td-x": "1", "title": "Gợi ý", "allow-create": "" } }],
      "expect": { "values": [], "leaves": 1, "name": "p[]" }, "dropped": ["onclick", "evil", "data-td-x", "allow-create"] },
    { "id": "m-xss", "args": ["x\"y[]", [{ "value": "<b>v</b>", "label": "<img src=x onerror=alert(1)>" }, { "label": "<script>g</script>", "options": [{ "value": "q\"", "label": "\"q\"" }] }], ["q\""], { "id": "m-xss", "label": "<i>nhãn</i>" }],
      "expect": { "values": ["q\""], "leaves": 2, "groups": ["<script>g</script>"], "name": "x\"y[]", "label": "<i>nhãn</i>" } },
    { "id": "m-focus", "browser": "focus", "args": ["focus[]", { "a": "A", "b": "B", "c": "C" }, ["a"], { "id": "m-focus", "label": "Đang chọn" }],
      "expect": { "values": ["a"], "leaves": 3, "name": "focus[]" } }
  ],
  "nativeCases": [
    { "id": "n-basic", "args": ["roles[]", { "admin": "Quản trị", "editor": "Biên tập", "viewer": "Xem" }, ["admin", "viewer"], { "label": "Vai trò", "id": "n-basic" }], "submit": [["roles[]", "admin"], ["roles[]", "viewer"]] },
    { "id": "n-groups", "args": ["c[]", [{ "label": "Nhóm", "options": { "a": "A", "b": "B" } }, { "label": "Khoá", "disabled": true, "options": { "z": "Z" } }], ["b", "z"], { "id": "n-groups", "required": true }], "submit": [["c[]", "b"]] },
    { "id": "n-none", "args": ["none[]", { "a": "A" }, [], { "id": "n-none" }], "submit": [] }
  ],
  "modes": [
    { "global": false, "call": "absent", "element": false },
    { "global": false, "call": false, "element": false },
    { "global": false, "call": true, "element": true },
    { "global": true, "call": "absent", "element": true },
    { "global": true, "call": false, "element": false },
    { "global": true, "call": true, "element": true }
  ]
