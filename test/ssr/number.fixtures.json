{
  "_note": "v0.30.0 (plan v0.30.0-number-repeater M3) SSR contract number-input@1 (ADR 0012): td_number_input() prints by default a NATIVE field (`div.td-field.td-number` + label + `div.td-number__box` > [prefix] `input.td-number__control` type=number with name / canonical value / min (implicit 0) / max / step (10^-decimals by default) / required [suffix] [hidden unit] + footer + status — works without JS, submits the clean number); element mode (`element => true` or Td::configure ssr_elements) wraps the same tree in `<td-number-input data-td-ssr=\"number-input@1\">`, adopted IN PLACE by <td-number-input> (same node, type → text, display grouped). Shared by test/php/td-ssr-number.test.js (PHP output) and src/form/td-number-input.ssr.engines.browser-test.js (Chromium / Firefox / WebKit, via test/ssr/fixtures/number.html — GENERATED by `node test/ssr/build-number-fixture.mjs`; the PHP test fails when it is stale). `expect`: the state the hydrated element must hold (canonical value, display, control id, host id, label, required / disabled / readonly, error). `dropped`: `attrs` entries that must reach neither the host nor the control.",
  "schema": "number-input@1",
  "cases": [
    { "id": "n-basic", "args": ["price", null, { "element": true }], "expect": { "value": "", "display": "" } },
    { "id": "n-full", "args": ["price", "12990000", { "element": true, "label": "Giá bán", "required": true, "suffix": "₫", "unit_label": "đồng", "hint": "Đã gồm VAT", "min": "1000" }], "expect": { "value": "12990000", "display": "12.990.000", "label": "Giá bán", "required": true, "unit": "đồng" } },
    { "id": "n-id", "args": ["cost", 5000, { "element": true, "id": "cost", "label": "Giá vốn" }], "expect": { "value": "5000", "display": "5.000", "controlId": "cost", "hostId": "cost-host", "label": "Giá vốn" } },
    { "id": "n-decimals", "args": ["rate", "12.5", { "element": true, "decimals": 2, "suffix": "%", "min": "0", "max": "100", "step": "0.5", "size": "sm" }], "expect": { "value": "12.5", "display": "12,5" } },
    { "id": "n-negative", "args": ["adj", "-1500", { "element": true, "min": "-1000000", "group_separator": " ", "aria_label": "Điều chỉnh" }], "expect": { "value": "-1500", "display": "-1 500", "ariaLabel": "Điều chỉnh" } },
    { "id": "n-usd", "args": ["usd", "1234.5", { "element": true, "prefix": "$", "decimals": 2, "group_separator": ",", "size": "lg" }], "expect": { "value": "1234.5", "display": "1,234.5" } },
    { "id": "n-error", "args": ["p", "7", { "element": true, "label": "Hoàn tiền", "error": "Vượt quá số đã thu" }], "expect": { "value": "7", "display": "7", "label": "Hoàn tiền", "error": "Vượt quá số đã thu" } },
    { "id": "n-disabled", "args": ["p", "1", { "element": true, "disabled": true }], "expect": { "value": "1", "display": "1", "disabled": true } },
    { "id": "n-readonly", "args": ["p", "2000", { "element": true, "readonly": true, "clamp": true, "max": "5000" }], "expect": { "value": "2000", "display": "2.000", "readonly": true } },
    { "id": "n-attrs", "args": ["code", "9", { "element": true, "id": "n-at", "attrs": { "name": "evil", "value": "1", "min": "-5", "Type": "text", "onclick": "alert(1)", "data-td-x": "1", "data-y": "2", "title": "Gợi ý" } }], "expect": { "value": "9", "display": "9", "controlId": "n-at" }, "dropped": ["onclick", "data-td-x"] },
    { "id": "n-xss", "args": ["x", null, { "element": true, "label": "<img src=x onerror=alert(1)>", "prefix": "<b>", "suffix": "\"><i>", "unit_label": "<svg onload=1>", "hint": "<script>1</script>" }], "expect": { "value": "", "display": "", "label": "<img src=x onerror=alert(1)>" } }
  ],
  "nativeCases": [
    { "id": "nn-full", "args": ["price", "12990000", { "label": "Giá bán", "required": true, "suffix": "₫", "min": "1000", "max": "100000000" }] },
    { "id": "nn-decimals", "args": ["rate", "12.5", { "decimals": 2, "suffix": "%", "label": "Tỉ lệ" }] }
  ],
  "modes": [
    { "global": false, "call": "absent", "element": false },
    { "global": false, "call": false, "element": false },
    { "global": false, "call": true, "element": true },
    { "global": true, "call": "absent", "element": true },
    { "global": true, "call": false, "element": false },
    { "global": true, "call": true, "element": true }
  ]
