        { "id": "b", "time": "2026-10-04T16:59:00.123456Z", "title": "Báo giá", "tone": "info", "icon": "send" },
        { "id": "c", "time": "2026-10-02T03:00:00+07:00", "title": "Liên hệ" }
      ], { "time_zone": "Asia/Ho_Chi_Minh", "now": "2026-10-05T03:00:00Z" }],
      "expect": { "tz": "Asia/Ho_Chi_Minh", "groups": [["2026-10-05", "Hôm nay", ["a"]], ["2026-10-04", "Hôm qua", ["b"]], ["2026-10-02", "Thứ Sáu, 02/10/2026", ["c"]]], "warns": 0 }
    },
    {
      "id": "t-details",
      "args": [[
