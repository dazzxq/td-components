      "expect": { "tz": "Asia/Ho_Chi_Minh", "groups": [["2026-10-05", "Hôm nay", ["a"]]], "warns": 0, "browserNow": "2026-10-06T03:00:00Z", "browserLabel": "Hôm qua" }
    },
    {
      "id": "t-empty",
      "args": [[], { "time_zone": "Asia/Ho_Chi_Minh", "empty_text": "Đơn này chưa có lịch sử", "has_more": true }],
