{
  "name": "@dazzxq/td-components",
  "version": "0.18.0",
  "description": "Shared UI Web Components library — single source of truth UI kit (token CSS + Liquid Glass)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "npm run check:css && npm run check:icons && npm run check:stories && npm run test:node && npm run test:browser && npm run test:csp && npm run test:csp:combined && npm run test:tokens && npm run test:contrast && npm run test:engines",
    "test:node": "node --test --test-force-exit \"src/**/*.test.js\" \"test/php/*.test.js\"",
    "test:browser": "web-test-runner",
    "test:csp": "node test/csp/csp.spec.mjs",
    "test:csp:combined": "CSP_PROFILE=legacy+td node test/csp/csp.spec.mjs",
    "test:tokens": "node test/tokens/tokens.spec.mjs",
    "build:css": "node scripts/build-css.mjs",
    "check:css": "node scripts/build-css.mjs --check",
    "build:icons": "node scripts/build-icons.mjs",
    "check:icons": "node scripts/build-icons.mjs --check",
    "build:csp-fixture": "tailwindcss -i test/csp/fixture/input.css -o test/csp/fixture/tailwind.css",
    "capture:baseline": "node test/csp/capture-baseline.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "demo": "vite --open /demo.html",
    "check:stories": "node --import ./scripts/check-stories/register.mjs scripts/check-stories.mjs",
    "test:engines": "node test/engines/menu-tab.spec.mjs",
    "test:contrast": "node test/tokens/contrast.spec.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./td.css": "./td.css",
    "./icons": "./src/icons/td-icon.js",
    "./icon-element": "./src/icons/td-icon-element.js",
    "./icons.json": "./src/icons/icons.json",
    "./base": "./src/base/td-base-element.js",
    "./form-element": "./src/base/td-form-element.js",
    "./sample": "./src/base/sample/td-sample.js",
    "./toggle": "./src/form/td-toggle.js",
    "./checkbox": "./src/form/td-checkbox.js",
    "./button": "./src/form/td-button.js",
    "./input-field": "./src/form/td-input-field.js",
    "./slider": "./src/form/td-slider.js",
    "./dropdown": "./src/form/td-dropdown.js",
    "./chip-input": "./src/form/td-chip-input.js",
    "./password-meter": "./src/form/td-password-meter.js",
    "./dropzone": "./src/form/td-dropzone.js",
    "./datetime": "./src/utils/datetime.js",
    "./datetime-picker": "./src/form/td-datetime-picker.js",
    "./modal": "./src/feedback/td-modal.js",
    "./modal-stack": "./src/feedback/td-modal-stack.js",
    "./lightbox": "./src/feedback/td-lightbox.js",
    "./toast": "./src/feedback/td-toast.js",
    "./tooltip": "./src/feedback/td-tooltip.js",
    "./loading": "./src/feedback/td-loading.js",
    "./menu": "./src/feedback/td-menu.js",
    "./hovercard": "./src/feedback/td-hovercard.js",
    "./scroll-top": "./src/feedback/td-scroll-top.js",
    "./progress": "./src/feedback/td-progress.js",
    "./alert": "./src/feedback/td-alert.js",
    "./table": "./src/display/td-table.js",
    "./tabs": "./src/display/td-tabs.js",
    "./pagination": "./src/display/td-pagination.js",
    "./empty-state": "./src/display/td-empty-state.js",
    "./dom-utils": "./src/utils/dom-utils.js",
    "./form-validation": "./src/utils/form-validation.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.browser-test.js",
    "!src/**/*.stories.js",
    "!src/**/*.stories.css",
    "!src/styles/story-layout.css",
    "index.js",
    "php",
    "td.css",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css",
    "./src/base/sample/td-sample.js",
    "./src/icons/td-icon-element.js",
    "./src/feedback/td-progress.js",
    "./src/feedback/td-alert.js",
    "./src/feedback/td-scroll-top.js",
    "./src/feedback/td-tooltip.js",
    "./src/form/td-button.js",
    "./src/form/td-checkbox.js",
    "./src/form/td-chip-input.js",
    "./src/form/td-datetime-picker.js",
    "./src/form/td-dropdown.js",
    "./src/form/td-dropzone.js",
    "./src/form/td-input-field.js",
    "./src/form/td-password-meter.js",
    "./src/form/td-slider.js",
    "./src/form/td-toggle.js",
    "./src/display/td-empty-state.js",
    "./src/display/td-pagination.js",
    "./src/display/td-table.js",
    "./src/display/td-tabs.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "web-components",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dazzxq/td-components.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/web-components-vite": "^8.6.18",
    "@tailwindcss/cli": "4.2.2",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "playwright-core": "1.60.0",
    "storybook": "^8.6.18",
    "vite": "^6.4.3"
  }
}
